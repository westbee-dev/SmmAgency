# ==============================================================================
# Этап 1: Сборка фронтенда с помощью Node.js и Vite (Build Stage)
# ==============================================================================
FROM node:22-alpine AS build
WORKDIR /app

# Копируем манифесты зависимостей и устанавливаем пакеты
COPY package*.json ./
RUN npm install

# Копируем исходный код фронтенда и запускаем сборку бандла
COPY . .
RUN npm run build

# ==============================================================================
# Этап 2: Финальный высокопроизводительный веб-сервер Nginx (Production Stage)
# ==============================================================================
FROM nginx:alpine AS runtime

# Копируем скомпилированные статические файлы из этапа сборки
COPY --from=build /app/dist /usr/share/nginx/html

# Копируем файл конфигурации виртуального хоста Nginx с настроенным проксированием API
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Nginx слушает порт 80 внутри контейнера
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
