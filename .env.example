# ==============================================================================
# Пример файла конфигурации переменных окружения для Docker Compose
# Скопируйте этот файл в .env и укажите свои надежные пароли:
#   cp .env.example .env (Linux/macOS) или Copy-Item .env.example .env (PowerShell)
# Файл .env добавлен в .gitignore и НЕ попадет в репозиторий.
# ==============================================================================

# PostgreSQL
POSTGRES_DB=smm_agency
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# JWT Settings (минимум 32 символа)
JWT_SECRET_KEY=super_secret_jwt_key_for_production_min_32_chars!

# Начальный администратор (создается при первом запуске, если база пустая)
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
